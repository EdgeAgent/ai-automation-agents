# Copy to .env for live (non-demo) runs. Demos and tests never read this file.
# Only needed when you swap a fake provider for the real OpenAI provider.
OPENAI_API_KEY=<redacted>
AI_AGENTS_MODEL=gpt-4o-mini
# Where the shared memory store persists recipe memory (JSON, local only).
AI_AGENTS_MEMORY_PATH=.ai-agents-memory.json
